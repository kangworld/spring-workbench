#!/usr/bin/env bash
# managed-by: agent-instruction-gate
set -euo pipefail

hook_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
original_hook="$hook_dir/pre-commit.agent-instruction-gate.original"
gate_dir="$hook_dir/agent-instruction-gate"

if [ -f "$original_hook" ]; then
	"$original_hook" "$@"
fi

case "$(uname -s)" in
	MINGW*|MSYS*|CYGWIN*)
		gate_script="$(cygpath -w "$gate_dir/gate.ps1")"
		powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$gate_script"
		;;
	*)
		"$gate_dir/gate.sh"
		;;
esac
